---
import type { IndexId } from '../data/products';
import pikkiMark from '../assets/portfolio/pikki.svg?url';

interface Props {
  product: IndexId;
}

const { product } = Astro.props;
const marks = {
  arrival: '/arrival-slip/mark.svg',
  audience: '/audience-cut.svg',
  culture: '/culture-register/assets/synthworx.svg',
  captions: '',
  federal: '/federal-desk/icon.svg',
  outcome: '/outcome-prompt/logo.png',
  pikki: pikkiMark,
};
---
<span class={'product-mark mark-' + product} aria-hidden="true">
  {product === 'captions' ? <i></i> : <img src={marks[product]} alt="" width="23" height="23" />}
</span>
