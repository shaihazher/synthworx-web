---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import HeroByline from '../components/HeroByline.astro';

const subject = 'Automation Diagnostic — request';
const body = `Company:
What the manual workflow is:
Volume (orders / loads / invoices per week):
Systems involved (ERP, TMS, WMS, OCR / RPA):
Where it breaks:
Timeline:
How you found me:`;
const diagnosticMailto = `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const sessionSubject = 'Paid strategy session — request';
const sessionBody = `Company:
Your role:
The manual workflow:
Volume (orders / loads / invoices per week):
Systems involved (ERP, TMS, WMS, OCR / RPA):
The decision you are trying to make:
Timeline:`;
const sessionMailto = `mailto:${SITE.email}?subject=${encodeURIComponent(sessionSubject)}&body=${encodeURIComponent(sessionBody)}`;

const deliverables = [
  {
    num: '01',
    title: 'Workflow map',
    body: 'Intake → process → handoff → exception → audit, with volumes, owners, and the manual steps named.',
  },
  {
    num: '02',
    title: 'Manual-cost model',
    body: 'Hours per transaction, error and rework, cycle time, cost per transaction. Every assumption labelled.',
  },
  {
    num: '03',
    title: 'Automation stack review',
    body: 'What you already own — ERP, TMS, WMS, OCR, RPA — what it actually does, and where it stops.',
  },
  {
    num: '04',
    title: 'Vendor and tooling options',
    body: 'OCR/IDP, RPA, workflow, ERP add-ons. Build vs buy vs partner, with real prices and trade-offs.',
  },
  {
    num: '05',
    title: '90-day roadmap',
    body: 'Ranked by payback. The first pilot is scoped, with the baseline and the success measure agreed.',
  },
  {
    num: '06',
    title: 'Go / no-go',
    body: 'Including “do not automate this yet” if that is the honest answer. The document is yours either way.',
  },
];

const offers = [
  {
    num: '01',
    name: 'Paid Strategy Session',
    price: '$1,500',
    duration: '90 minutes',
    body: 'A working session on your workflow: recorded, one-page memo, three prioritized recommendations. If the memo is not useful, tell me within 7 days and I refund the fee. The fee is credited toward the diagnostic if you sign within 14 days.',
    featured: true,
  },
  {
    num: '02',
    name: 'Automation Diagnostic',
    price: '$12,500',
    duration: '2 weeks',
    body: 'Workflow map, manual-cost model, stack review, vendor options, 90-day roadmap, go/no-go. The core offer.',
    featured: true,
  },
  {
    num: '03',
    name: 'Automation Sprint',
    price: '$25K–$50K',
    duration: '4–6 weeks',
    body: 'One workflow automated end to end: OCR/IDP, RPA, API, human review, QA, and handoff. Scoped by the diagnostic. I do the work myself, alongside your team and any partners you already use. Nothing is subcontracted.',
  },
  {
    num: '04',
    name: 'Fractional Automation Ops',
    price: '$5K–$8K/mo',
    duration: '3-month minimum',
    body: 'Vendor management, QA, cost and quality, roadmap. After a sprint — not instead of one.',
  },
];

const objections = [
  {
    q: 'We already have RPA.',
    a: 'RPA automates the happy path. The cost is in the exceptions — the bot stops, and a person finishes. The diagnostic maps where it stops and what that costs.',
  },
  {
    q: 'Our data is messy.',
    a: 'Then the first fix is intake and normalisation, not a model. That is scoped as step one, not hand-waved.',
  },
  {
    q: 'We tried a pilot.',
    a: 'Most pilots automate a task and leave the handoff manual. The diagnostic maps the handoff and names the owner before anyone buys a tool.',
  },
  {
    q: 'We have no IT team.',
    a: 'Then the output has to be tools your ops lead can run, with a runbook. If you need a build, I do it myself or work with the vendors and partners you already have. I do not subcontract.',
  },
];
---

<BaseLayout
  title="Automation for operators"
  description="Two-week automation diagnostic for 100–1,000-person logistics, distribution, manufacturing, and construction operators. Workflow map, manual-cost model, vendor selection, 90-day plan. Fixed fee, written output."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Automation Diagnostic',
      serviceType: 'Automation and workflow diagnostic for mid-market operators',
      provider: { '@type': 'Person', name: SITE.owner, url: `${SITE.url}/about` },
      areaServed: 'US',
      description:
        'Two-week diagnostic for 100–1,000-person logistics, distribution, manufacturing, and construction operators: workflow map, manual-cost model, automation stack review, vendor selection, 90-day roadmap, go/no-go.',
      offers: [
        {
          '@type': 'Offer',
          name: 'Paid Strategy Session',
          price: '1500',
          priceCurrency: 'USD',
          description: '90-minute working session on the workflow, recorded, with a one-page memo and three prioritized recommendations. Credited toward the diagnostic if signed within 14 days.',
        },
        {
          '@type': 'Offer',
          name: 'Automation Diagnostic',
          price: '12500',
          priceCurrency: 'USD',
          description: 'Two-week Automation Diagnostic, fixed fee, written output.',
        },
      ],
    })}
  />

  <!-- Hero -->
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Automation for logistics, distribution, and manufacturing</p>
        <h1 class="display display--xl">
          Your best people are<br /><em>holding the process</em> together.
        </h1>
        <HeroByline role="Founder, Synthworx · 9 years in Amazon operations" />
        <p class="lede hero__sub">
          The re-keying. The chasing. The reconciling. I map the manual workflow, price the hours it consumes,
          and automate the highest-cost step — starting with a 90-minute session, before you buy another system.
        </p>
        <p class="proof-bar" style="margin-top:26px;">
          <span>9 years in Amazon operations</span><span class="dot">·</span>
          <span>$20M+ cost reduction</span><span class="dot">·</span>
          <span>100,000+ classes classified</span><span class="dot">·</span>
          <span>processing time halved</span>
        </p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={sessionMailto}>Book the session — $1,500</a>
          <a class="btn btn--ghost" href="#deliverables">What the diagnostic produces</a>
        </div>
        <p class="hero__note tiny">
          No free discovery calls. The 90-minute strategy session is the first step — $1,500, credited toward the two-week diagnostic.
        </p>
      </div>

      <aside class="hero__panel" aria-label="Where the manual cost sits">
        <div class="hero__panel-head">
          <span class="mono" style="font-size:10px;letter-spacing:.1em;">WHERE THE COST SITS</span>
          <span class="status-dot" aria-label="Operational"></span>
        </div>
        <ul class="stack-list">
          <li>
            <span class="num">01</span>
            <span class="name">Intake</span>
            <span class="state">re-key</span>
          </li>
          <li>
            <span class="num">02</span>
            <span class="name">Handoff</span>
            <span class="state">queue</span>
          </li>
          <li>
            <span class="num">03</span>
            <span class="name">Exception</span>
            <span class="state">rework</span>
          </li>
        </ul>
        <div class="hero__panel-foot">
          The system works most of the time. The 5% that does not is where the hours go.
        </div>
      </aside>
    </div>
  </section>

  <!-- The gap -->
  <section class="section section--line">
    <div class="shell">
      <div class="grid-12">
        <div style="grid-column: span 5;">
          <p class="eyebrow">The gap</p>
          <h2 class="display display--lg" style="margin:18px 0 24px;">
            The work is manual. <em>The cost is invisible.</em>
          </h2>
        </div>
        <div style="grid-column: 7 / span 6;">
          <p class="lede">
            Most operators do not have an AI problem. They have a workflow problem — and buying a tool before
            mapping it is how the tool becomes another queue.
          </p>
          <p style="margin-top:18px;color:var(--color-muted);font-size:14.5px;">
            You already know where it hurts. What you do not have is the hours and the cost per transaction
            attached to it, in one document, with a ranked fix.
          </p>
        </div>
      </div>

      <div class="grid-12" style="margin-top:clamp(40px,6vw,72px);">
        <div class="card card--flat" style="grid-column: span 4;">
          <span class="card__index">01 / INTAKE</span>
          <h3>The work arrives as email, PDF, and phone calls</h3>
          <p>Orders, carrier packets, invoices, and spec sheets get re-keyed because no system owns the front door.</p>
        </div>
        <div class="card card--flat" style="grid-column: span 4;">
          <span class="card__index">02 / HANDOFF</span>
          <h3>The handoff is the cost</h3>
          <p>Quote to order. Order to dispatch. Dispatch to invoice. Each handoff has an owner, a queue, and a rework loop.</p>
        </div>
        <div class="card card--flat" style="grid-column: span 4;">
          <span class="card__index">03 / EXCEPTION</span>
          <h3>The 5% that breaks eats the margin</h3>
          <p>A lapsed certificate, a PO that arrives by email, an accessorial with no proof. The exception is where the hours go.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="section section--paper-deep" id="deliverables" style="scroll-margin-top:90px;">
    <div class="shell">
      <div class="grid-12" style="align-items:end;">
        <div style="grid-column: span 7;">
          <p class="eyebrow">The diagnostic</p>
          <h2 class="display display--lg" style="margin:18px 0 0;">
            Two weeks. <em>One document.</em> A decision.
          </h2>
        </div>
        <div style="grid-column: 9 / span 4;">
          <p class="tiny" style="margin:0;color:var(--color-muted);">
            Most operators start with the 90-minute session. The diagnostic is the next step, and the session fee is credited.
          </p>
        </div>
      </div>

      <div class="grid-12" style="margin-top:clamp(34px,5vw,58px);align-items:start;">
        <div style="grid-column: span 7;">
          <div class="steps" style="border-top:1px solid var(--color-line);">
            {deliverables.map((item) => (
              <div class="step">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div style="grid-column: 9 / span 4;">
          <div class="callout-box">
            <p class="mono" style="font-size:10px;color:var(--color-accent-deep);margin:0 0 12px;">WHAT IT IS NOT</p>
            <ul style="list-style:none;margin:0 0 22px;padding:0;">
              {[
                'A tool demo',
                'A strategy deck',
                'A staff-augmentation contract',
                'A free audit',
              ].map((item) => (
                <li style="padding:8px 0;border-bottom:1px solid var(--color-line);font-size:14px;color:var(--color-ink-soft);">
                  {item}
                </li>
              ))}
            </ul>
            <p class="mono" style="font-size:10px;color:var(--color-accent-deep);margin:0 0 10px;">THE GUARANTEE</p>
            <p style="margin:0;font-size:14px;line-height:1.55;color:var(--color-ink-soft);">
              If the diagnostic does not identify at least two automation opportunities with a payback under
              12 months, I refund it. The $1,500 session fee is credited toward it, and 50% of the diagnostic fee is credited toward a sprint signed within 30 days.
            </p>
          </div>
          <a class="btn btn--solid" href={sessionMailto} style="width:100%;margin-top:18px;justify-content:center;">
            Book the session — $1,500
          </a>
          <p class="tiny" style="margin:10px 0 0;color:var(--color-muted);text-align:center;">
            Already know you need the diagnostic? <a href={diagnosticMailto}>Request it directly</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Offer ladder -->
  <section class="section" id="offers" style="scroll-margin-top:90px;">
    <div class="shell">
      <div class="grid-12" style="align-items:end;">
        <div style="grid-column: span 7;">
          <p class="eyebrow">The ladder</p>
          <h2 class="display display--lg" style="margin:18px 0 0;">
            Diagnose. <em>Fix.</em> Hand off.
          </h2>
        </div>
        <div style="grid-column: 9 / span 4;">
          <p class="tiny" style="margin:0;color:var(--color-muted);">
            The diagnostic produces the scope for everything after it. I do not quote a sprint before I have
            seen the workflow.
          </p>
        </div>
      </div>

      <div class="grid-12" style="margin-top:clamp(34px,5vw,58px);align-items:stretch;">
        {offers.map((offer) => (
          <div class={`card${offer.featured ? '' : ' card--flat'}`} style="grid-column: span 6;display:flex;flex-direction:column;">
            <span class="card__index">{offer.num} / {offer.duration}</span>
            <h3>{offer.name}</h3>
            <p class="mono" style="font-size:15px;color:var(--color-ink);margin:0 0 12px;">{offer.price}</p>
            <p style="flex:1;">{offer.body}</p>
          </div>
        ))}
      </div>

      <p class="tiny" style="margin-top:22px;color:var(--color-muted);max-width:720px;">
        Fixed fee. No hourly billing. The $1,500 session fee is credited toward the diagnostic if you sign within 14 days. The tool is secondary — OCR, RPA, API, or a model, chosen after the workflow map, not before it. I do not sell software or take referral fees.
      </p>
    </div>
  </section>

  <!-- Fit -->
  <section class="section section--line">
    <div class="shell">
      <div class="grid-12" style="align-items:start;">
        <div style="grid-column: span 5;">
          <p class="eyebrow">Fit</p>
          <h2 class="display display--lg" style="margin:18px 0 24px;">
            A strong operation with <em>a manual seam.</em>
          </h2>
          <p class="lede" style="font-size:1.02rem;">
            Ops owns the problem. IT owns the systems. The diagnostic gives both a written map and a prioritised
            backlog — which is why it is usually the COO who forwards it to the CIO.
          </p>
          <div style="margin-top:22px;">
            <a class="link-arrow" href="/about" style="font-size:13px;">The operator background</a>
          </div>
        </div>

        <div style="grid-column: 7 / span 6;">
          <div class="grid-12">
            <div style="grid-column: span 6;">
              <p class="mono" style="font-size:10px;color:var(--color-accent-deep);margin:0 0 14px;">A FIT</p>
              <ul style="list-style:none;margin:0;padding:0;">
                {[
                  'Logistics and freight, distribution and wholesale, manufacturing, construction and building materials, facilities and field services',
                  '$10M–$250M revenue, 100–1,000 employees',
                  'Multi-site or high transaction volume',
                  'A CIO, VP IT, or COO with an IT lead',
                  'At least one process that still runs on email, spreadsheets, or a person who “knows how it works”',
                ].map((item) => (
                  <li style="display:grid;grid-template-columns:18px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--color-line);font-size:14px;color:var(--color-ink-soft);">
                    <span style="color:var(--color-accent);font-family:var(--font-mono);font-size:10px;padding-top:4px;">+</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div style="grid-column: span 6;">
              <p class="mono" style="font-size:10px;color:var(--color-muted);margin:0 0 14px;">NOT A FIT</p>
              <ul style="list-style:none;margin:0;padding:0;">
                {[
                  'Software companies — that is the other practice',
                  'Pure strategy work with no access to systems or data',
                  'Staff augmentation or hourly development',
                  'A business with no one who owns the systems',
                  'Buying a tool before mapping the work',
                ].map((item) => (
                  <li style="display:grid;grid-template-columns:18px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--color-line);font-size:14px;color:var(--color-muted);">
                    <span style="font-family:var(--font-mono);font-size:10px;padding-top:4px;">−</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="section">
    <div class="shell">
      <div class="grid-12" style="align-items:end;">
        <div style="grid-column: span 7;">
          <p class="eyebrow">Method</p>
          <h2 class="display display--lg" style="margin:18px 0 0;">
            Five steps. <em>No black box.</em>
          </h2>
        </div>
      </div>

      <div class="grid-12" style="margin-top:clamp(34px,5vw,58px);">
        <div class="steps" style="grid-column: span 12;">
          <div class="step">
            <h3>Workflow map</h3>
            <p>Intake → process → handoff → exception → audit, with volumes and owners for each step.</p>
          </div>
          <div class="step">
            <h3>Manual-cost model</h3>
            <p>Hours per transaction, error and rework, cycle time, cost per transaction. Every assumption labelled.</p>
          </div>
          <div class="step">
            <h3>Vendor and tooling selection</h3>
            <p>OCR/IDP, RPA, workflow, ERP add-ons. Build vs buy vs partner, with prices and trade-offs.</p>
          </div>
          <div class="step">
            <h3>Pilot</h3>
            <p>One workflow, measured against a baseline agreed before the work starts. No pilot without a measure.</p>
          </div>
          <div class="step">
            <h3>Handoff</h3>
            <p>Runbook, cost model, failure modes, named owner. Your team keeps the system.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Objections -->
  <section class="section section--paper-deep">
    <div class="shell">
      <p class="eyebrow">Straight answers</p>
      <h2 class="display display--lg" style="margin:18px 0 30px;max-width:820px;">
        The questions a COO <em>actually asks.</em>
      </h2>

      <div class="grid-12">
        {objections.map((item, i) => (
          <div class="card card--flat" style="grid-column: span 6;">
            <span class="card__index">0{i + 1}</span>
            <h3>“{item.q}”</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="section section--line">
    <div class="shell">
      <div class="grid-12" style="align-items:start;">
        <div style="grid-column: span 5;">
          <p class="eyebrow">Why me</p>
          <h2 class="display display--lg" style="margin:18px 0 24px;">
            Operator first. <em>Architect second.</em>
          </h2>
          <p class="lede" style="font-size:1.02rem;">
            I spent nine years in Amazon operations before I moved to the systems side — then built the
            classification and exception layer for a platform doing 2M requests an hour.
          </p>
          <p style="margin-top:18px;color:var(--color-muted);font-size:14px;">
            That order matters. It means I design for the person doing the work and for the cost of running the
            system, not just for the benchmark.
          </p>
        </div>

        <div style="grid-column: 7 / span 6;">
          <div class="card card--flat" style="margin-bottom:16px;">
            <span class="card__index">01 / OPERATOR RECORD</span>
            <h3>Nine years in operations</h3>
            <p>Operations, programme management, and product at Amazon. I have been the person who has to make the process work at 6am, and the person who has to explain why it did not.</p>
          </div>
          <div class="card card--flat" style="margin-bottom:16px;">
            <span class="card__index">02 / SYSTEMS RECORD</span>
            <h3>Throughput, quality, and cost</h3>
            <p>100,000+ classes classified, accuracy up 35%, processing time halved. More than $20M in savings delivered. The 2M requests/hour system held at 99.99% because the exception layer was designed, not hoped for.</p>
          </div>
          <div class="card card--flat">
            <span class="card__index">03 / INDEPENDENT</span>
            <h3>No software to sell</h3>
            <p>No referral fees, no partner programme, no reseller margin. Where the right answer is a product you buy without me, I say so in writing, in a document you keep.</p>
          </div>
          <p class="tiny" style="margin-top:18px;color:var(--color-muted);">
            No borrowed logos. The Amazon work is labelled; client automation work is published only with
            permission. Chennai, India · 8–11am ET overlap · 16 years working with US teams.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark" id="start" style="scroll-margin-top:90px;">
    <div class="shell grid-12" style="align-items:end;">
      <div style="grid-column: span 7;">
        <p class="eyebrow">Start</p>
        <h2 class="display display--lg" style="margin:18px 0 20px;">
          Start with 90 minutes, <em>not a software purchase.</em>
        </h2>
        <p class="lede" style="font-size:1.05rem;">
          Two weeks, $12,500, a written document: where the manual cost is, what it costs per transaction, what
          to automate first, and a 90-day plan.
        </p>
        <div class="hero__actions" style="margin-top:26px;">
          <a class="btn btn--solid" href={sessionMailto}>Book the session — $1,500</a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>Email {SITE.email}</a>
        </div>
        <p class="tiny" style="color:#a8b0a9;margin-top:18px;">
          I reply within 24 hours, Monday–Friday, with a one-page scope and a start date — or a clear no with the
          reason.
        </p>
      </div>
      <div style="grid-column: 9 / span 4;">
        <div class="callout-box" style="background:transparent;border-color:var(--color-line);">
          <p class="mono" style="font-size:10px;color:var(--color-cream);margin:0 0 14px;">WHAT TO SEND</p>
          <ul style="list-style:none;margin:0;padding:0;">
            {[
              'Company and your role',
              'The manual workflow',
              'Volume per week',
              'Systems involved',
              'Where it breaks',
              'Timeline',
            ].map((item, i) => (
              <li style="display:grid;grid-template-columns:22px 1fr;gap:10px;padding:9px 0;border-bottom:1px solid var(--color-line-dark);font-size:13.5px;color:var(--color-cream);">
                <span style="font-family:var(--font-mono);font-size:10px;color:#a8b0a9;padding-top:3px;">0{i + 1}</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="shell" style="margin-top:clamp(38px,5vw,64px);padding-top:22px;border-top:1px solid var(--color-line-dark);">
      <p class="tiny" style="color:#a8b0a9;margin:0;">
        For software teams and AI systems, this is the other practice: <a href="/" style="color:var(--color-cream);">AI that survives production →</a>
      </p>
    </div>
  </section>
</BaseLayout>
