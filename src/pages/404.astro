---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page does not exist." noindex>
  <section class="section" style="min-height:52vh;display:flex;align-items:center;">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="display display--lg" style="margin:18px 0 20px;">That page is not <em>here.</em></h1>
      <p class="lede">The link may be old, or the page moved. The work, the fees, and the diagnostic are one click away.</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="/">Go home</a>
        <a class="btn btn--ghost" href="/work">See the work</a>
      </div>
    </div>
  </section>
</BaseLayout>
