---
import { Image } from 'astro:assets';
import Portfolio from '../layouts/Portfolio.astro';
import ProductMark from '../components/ProductMark.astro';
import ProductSpecimen from '../components/ProductSpecimen.astro';
import { products, services } from '../data/products';

const byName = [...products, ...services].sort((a, b) => a.name.localeCompare(b.name));
import indexPhoto from '../assets/portfolio/card-index.webp';

// Previously shared film briefs used fragments on the apex home page.
const filmSections = [
  'service', 'case-study', 'lights-out', 'it-comes-at-night', 'finding-0', 'finding-1', 'finding-2',
  'case-title', 'night-title', 'hero-title', 'contact', 'inquiry',
];
---
<Portfolio>
  <script slot="head" define:vars={{ filmSections }}>
    function followFilmLink() {
      if (filmSections.includes(location.hash.slice(1))) {
        location.replace('/audience-cut' + location.search + location.hash);
      }
    }
    followFilmLink();
    addEventListener('hashchange', followFilmLink);
  </script>
  <noscript>
    {filmSections.map(section => <a class="film-bookmark" id={section} href={'/audience-cut#' + section}>Continue to this section of Audience Cut</a>)}
  </noscript>

  <div class="wrap">
    <section class="cover" aria-labelledby="cover-title">
      <h1 id="cover-title"><span class="cover-prefix">The product</span> <em>index.</em></h1>
      <p class="cover-intro">Check a film’s captions, trace a customer inquiry, or research employers with H-1B transfer filings.</p>
      <div class="cover-photo"><Image src={indexPhoto} widths={[300, 540, 760, 1060, 1440]} sizes="(max-width: 639px) 40vw, (max-width: 1420px) 46vw, 650px" alt="A vermilion file box with six colorful index tabs." loading="eager" fetchpriority="high" format="webp" /></div>
    </section>

    <nav class="name-index" id="products" aria-labelledby="name-index-title">
      <h2 id="name-index-title">Find by name</h2>
      <ul>
        {byName.map(product => <li>
          <a href={product.href} aria-labelledby={'name-' + product.id} aria-describedby={'subject-' + product.id}>
            <span class="index-name" id={'name-' + product.id}><ProductMark product={product.id} />{product.name}</span>
            <span class="index-subject" id={'subject-' + product.id}>{product.subject}</span>
          </a>
        </li>)}
      </ul>
    </nav>

    <aside class="register-feature" aria-labelledby="register-heading">
      <img src="/culture-register/assets/cover.webp" width="1250" height="833" alt="" />
      <div>
        <p class="service-label">From the editors</p>
        <h2 id="register-heading">Culture <em>Register</em></h2>
        <p>Compare U.S. coverage of movies, music, fashion and beauty. Explore a trailer, a single or a product idea to test before you commit a budget.</p>
        <a href="/culture-register/?src=homepage">Open the free U.S. edition <span aria-hidden="true">↗</span></a>
      </div>
    </aside>

    <section class="catalog" aria-labelledby="tasks-title">
      <h2 id="tasks-title">Browse by task</h2>
      <div class="products-grid">
        {products.map(product => (
          <article class={'product product-' + product.id}>
            <a class="product-card" href={product.href} aria-labelledby={'task-' + product.id + ' brand-' + product.id}>
              <ProductSpecimen product={product.id} />
              <div class="product-copy">
                <p class="name-link" id={'brand-' + product.id}><ProductMark product={product.id} /><span>{product.name}</span></p>
                <h3 id={'task-' + product.id}>{product.task}</h3>
                <p class="product-description">{product.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <aside class="film-feature" aria-labelledby="film-name">
      <div class="film-copy">
        <p class="service-label">Film release service</p>
        <h2 id="film-name">Audience <em>Cut</em></h2>
        <p>Planning a U.S. release for an independent feature? We watch your cut and recommend who to reach first and which scenes to lead with in the trailer.</p>
        <a href="/audience-cut">Explore Audience Cut</a>
      </div>
    </aside>
  </div>
</Portfolio>
