---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { SITE } from '../data/site';

const sessionSubject = 'Paid strategy session — request';
const sessionBody = `Company:
Website:
Your role:
The decision you are trying to make:
The system (what it does, model/provider if relevant):
What is failing or stuck:
Timeline:
How you found me:`;
const sessionMailto = `mailto:${SITE.email}?subject=${encodeURIComponent(sessionSubject)}&body=${encodeURIComponent(sessionBody)}`;

const diagnosticSubject = 'AI Production Diagnostic — request';
const diagnosticBody = `Company:
Website:
Your role:
What the AI system does:
Where it runs (model, provider, stack):
Current volume (requests/day or month):
Current cost (monthly, approximate):
What is failing (latency, cost, quality, reliability, security):
What you have already tried:
Timeline:
How you found me:`;
const diagnosticMailto = `mailto:${SITE.email}?subject=${encodeURIComponent(diagnosticSubject)}&body=${encodeURIComponent(diagnosticBody)}`;
---

<BaseLayout
  title="Contact"
  description="Start with the $1,500 90-minute strategy session — a working session on your system, recorded, with a one-page memo and three prioritized recommendations. Credited toward the $12,500 AI Production Diagnostic if you sign within 14 days."
>
  <section class="article-head" id="session">
    <div class="shell grid-12" style="align-items:end;">
      <div style="grid-column: span 8;">
        <p class="eyebrow">Contact</p>
        <h1 class="display display--lg" style="margin-top:20px;">Start with <em>90 minutes.</em></h1>
        <p class="lede">
          The paid strategy session is $1,500, 90 minutes, and a working session on your system — recorded, with a
          one-page memo and three prioritized recommendations. The full fee is credited toward the $12,500
          two-week diagnostic if you sign within 14 days.
        </p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={sessionMailto}>Book the session — $1,500</a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>Email {SITE.email}</a>
        </div>
        <p class="tiny" style="color:var(--color-muted);margin-top:18px;">
          I reply within 24 hours, Monday–Friday. No contact form, no CRM sequence, no calendar link. I take on a
          small number of engagements at a time; if the timing does not fit, I will say so.
        </p>
      </div>
      <div style="grid-column: 10 / span 3;">
        <div class="callout-box callout-box--accent">
          <p class="mono" style="font-size:10px;color:var(--color-accent-deep);margin:0 0 10px;">The entry point</p>
          <p style="margin:0 0 12px;font-size:14px;line-height:1.55;">
            <strong>$1,500 · 90 minutes.</strong> A working session on your system, not a sales call. Recorded, with
            a one-page memo and three prioritized recommendations.
          </p>
          <p style="margin:0;font-size:13.5px;line-height:1.55;color:var(--color-ink-soft);">
            The full fee is credited toward the $12,500 diagnostic if you sign within 14 days.
          </p>
        </div>
        <div style="margin-top:22px;">
          <AuthorCard compact />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid-12" style="align-items:start;">
      <div style="grid-column: span 7;">
        <p class="eyebrow">What happens next</p>
        <h2 class="display display--md" style="margin:18px 0 28px;">Four steps. No discovery call.</h2>

        <div class="steps">
          <div class="step">
            <h3>You email the context</h3>
            <p>Use the intake list. The decision, the system, and what is failing are enough to start.</p>
          </div>
          <div class="step">
            <h3>I reply within 24 hours</h3>
            <p>A 90-minute slot and a short prep note, or a clear no with the reason. No pitch deck.</p>
          </div>
          <div class="step">
            <h3>You pay $1,500</h3>
            <p>Invoice in USD via Skydo / Wise / Stripe. W-8BEN provided. The session is confirmed when payment clears.</p>
          </div>
          <div class="step">
            <h3>90 minutes, then the memo</h3>
            <p>Recorded working session, a one-page memo within two business days, three prioritized recommendations, and a clear answer on whether the diagnostic is next.</p>
          </div>
        </div>

        <div class="callout-box" style="margin-top:34px;">
          <p class="mono" style="font-size:10px;color:var(--color-accent-deep);margin:0 0 10px;">The credit</p>
          <p style="margin:0 0 14px;font-size:14.5px;">
            The full $1,500 is credited toward the $12,500 AI Production Diagnostic if you sign within 14 days.
            If the diagnostic is not the right next step, the session still stands on its own.
          </p>
          <a class="link-arrow" href="/services#session" style="font-size:13px;">What the session includes</a>
        </div>
      </div>

      <div style="grid-column: 9 / span 4;">
        <div class="card card--flat">
          <p class="mono" style="font-size:10px;color:var(--color-accent);margin:0 0 14px;">What to send</p>
          <ul style="list-style:none;margin:0;padding:0;border-top:1px solid var(--color-line);">
            {[
              'Company, website, and your role',
              'The decision you are trying to make',
              'The system: what it does, model/provider if relevant',
              'What is failing or stuck',
              'What you have already tried',
              'Timeline and who else is involved',
            ].map((item, i) => (
              <li style="display:grid;grid-template-columns:22px 1fr;gap:10px;padding:11px 0;border-bottom:1px solid var(--color-line);font-size:13.5px;">
                <span style="font-family:var(--font-mono);font-size:10px;color:var(--color-muted);padding-top:3px;">0{i + 1}</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a class="btn btn--solid" href={sessionMailto} style="width:100%;margin-top:22px;">Open the email</a>
          <p class="tiny" style="color:var(--color-muted);margin-top:12px;">
            Prefer to write your own? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>

        <div style="margin-top:26px;padding-top:18px;border-top:1px solid var(--color-line);">
          <p class="mono" style="font-size:10px;color:var(--color-muted);margin:0 0 10px;">Before you send</p>
          <p style="font-size:13px;color:var(--color-muted);margin:0;">
            I sign NDAs and do not train on client data. Read the <a href="/security">security and NDA page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper-deep" id="diagnostic">
    <div class="shell grid-12" style="align-items:start;">
      <div style="grid-column: span 5;">
        <p class="eyebrow">02 — The next step</p>
        <h2 class="display display--md" style="margin:18px 0 18px;">AI Production Diagnostic</h2>
        <p class="price" style="font-size:18px;">$12,500 · 2 weeks</p>
        <p class="lede" style="margin-top:20px;font-size:1.02rem;">
          The core offer. A whole-stack audit, a cost and latency model, an eval gap analysis, a risk register, a
          90-day roadmap, and a go/no-go — in one written document you keep.
        </p>
        <div class="callout-box" style="margin-top:24px;">
          <p class="mono" style="font-size:10px;color:var(--color-accent-deep);margin:0 0 10px;">The guarantee</p>
          <p style="margin:0;font-size:14.5px;">
            If the diagnostic does not identify at least three opportunities worth 10× the fee, I refund it. 50% of
            the fee is credited toward a sprint or build signed within 30 days.
          </p>
        </div>
        <p class="tiny" style="color:var(--color-muted);margin-top:18px;">
          Already know the diagnostic is the right step? Email the system detail directly. If you are unsure, start
          with the session — the fee is credited.
        </p>
        <a class="btn btn--solid" href={diagnosticMailto} style="margin-top:18px;">Request the diagnostic</a>
      </div>

      <div style="grid-column: 7 / span 6;">
        <p class="mono" style="font-size:10px;color:var(--color-muted);margin:0 0 14px;">What to include</p>
        <div class="card card--flat">
          <ul style="list-style:none;margin:0;padding:0;">
            {[
              'What the AI system does',
              'Model, provider, and stack',
              'Volume: requests per day or month',
              'Current monthly cost',
              'What is failing: latency, cost, quality, reliability, security',
              'What you have already tried',
              'Timeline and decision process',
            ].map((item, i) => (
              <li style="display:grid;grid-template-columns:22px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--color-line);font-size:13.5px;">
                <span style="font-family:var(--font-mono);font-size:10px;color:var(--color-muted);padding-top:3px;">0{i + 1}</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a class="btn btn--solid" href={diagnosticMailto} style="width:100%;margin-top:20px;">Open the diagnostic email</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell grid-12" style="align-items:end;">
      <div style="grid-column: span 7;">
        <p class="eyebrow">Direct</p>
        <h2 class="display display--md" style="margin:18px 0 18px;">{SITE.email}</h2>
        <p class="lede" style="font-size:1.05rem;">
          Chennai, India · 8–11am ET overlap · replies within 24 hours, Monday–Friday.
        </p>
        <p class="tiny" style="color:#a8b0a9;margin-top:16px;">
          Prefer LinkedIn? <a href={SITE.linkedin} target="_blank" rel="me noopener" style="color:var(--color-cream);">Connect with me here ↗</a>
        </p>
      </div>
      <div style="grid-column: 9 / span 4;">
        <p class="tiny" style="color:#a8b0a9;margin:0;">
          For security disclosures, use the same address with “SECURITY” in the subject. For press or speaking, note that I am not doing podcasts or conferences during the first six months.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
