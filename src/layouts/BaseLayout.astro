---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  image = '/images/og.png',
  type = 'website',
  noindex = false,
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — AI that survives production`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://synthworx.com');
const ogImage = new URL(image, Astro.site ?? 'https://synthworx.com');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: SITE.owner,
      jobTitle: 'AI Systems Architect & Consultant',
      description:
        'Amazon ML Architect. Builds and fixes AI systems that have to survive production.',
      url: `${SITE.url}/about`,
      image: `${SITE.url}/images/azeruddin-sheikh.jpg`,
      worksFor: { '@id': `${SITE.url}/#org` },
      knowsAbout: [
        'Production AI systems',
        'LLM inference optimization',
        'Retrieval-augmented generation',
        'AI evaluation and observability',
        'Distributed systems',
      ],
      sameAs: [SITE.github, SITE.linkedin],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE.url}/#org`,
      name: SITE.name,
      legalName: SITE.legalName,
      url: SITE.url,
      email: SITE.email,
      description: SITE.description,
      areaServed: 'US',
      founder: { '@id': `${SITE.url}/#person` },
      sameAs: [SITE.linkedin, SITE.github],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Chennai',
        addressRegion: 'Tamil Nadu',
        addressCountry: 'IN',
      },
      makesOffer: [
        {
          '@type': 'Offer',
          name: 'AI Production Diagnostic',
          price: '12500',
          priceCurrency: 'USD',
        },
        {
          '@type': 'Offer',
          name: 'LLM Cost & Latency Sprint',
          price: '35000',
          priceCurrency: 'USD',
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#f3efe6" />
    <meta name="author" content={SITE.owner} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Notes`} href="/notes/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const items = document.querySelectorAll('.reveal');
      if (items.length) {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduced || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          items.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
