---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/audience.css';
const {title = 'Audience Cut | Audience strategy for independent film', description = 'A five-day audience and release brief for US independent producers and distributors. Choose a first audience, a trailer opening and an edit worth testing.', isHome = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://synthworx.com');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#111111"/><meta property="og:title" content={title}/><meta property="og:site_name" content="Audience Cut"/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content="https://synthworx.com/art/hero.webp"/><meta name="twitter:card" content="summary_large_image"/>{isHome && <link rel="preload" as="image" href="/art/hero.webp"/>}</head>
<body><a class="skip" href="#main">Skip to content</a>
<header><div class="bar shell"><a class="brand" href="/" aria-label="Audience Cut home"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>Audience Cut</a><nav aria-label="Primary"><a href="/#service">The service</a><a href="/#case-study">Case study</a><a class="nav-contact" href="/#contact">Discuss your film</a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="shell foot"><a class="brand" href="/"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>Audience Cut</a><span>A service of Synthworx DNS Ventures LLC</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div></footer></body></html>
