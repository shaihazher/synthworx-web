---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/audience.css';
const {title = 'Audience Cut | Audience positioning for independent US releases', description = 'Two pitches for your independent feature. Get a five-day brief on who to reach first, which scenes belong in the trailer and where to start your US campaign.', preloadArt = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://synthworx.com');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/audience-cut.svg" type="image/svg+xml"/><meta name="theme-color" content="#111111"/><meta property="og:title" content={title}/><meta property="og:site_name" content="Audience Cut"/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content="https://synthworx.com/art/hero.webp"/><meta name="twitter:card" content="summary_large_image"/>{preloadArt && <link rel="preload" as="image" href="/art/hero.webp"/>}</head>
<body><a class="skip" href="#main">Skip to content</a>
<header><div class="bar shell"><a class="brand" href="/audience-cut" aria-label="Audience Cut home"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>Audience Cut</a><nav aria-label="Primary"><a href="/audience-cut#service">The service</a><a href="/audience-cut#case-study">Case studies</a><a class="nav-contact" href="/audience-cut#contact">Discuss your film</a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="shell foot"><a class="brand" href="/audience-cut"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>Audience Cut</a><span>A service from <a href="/">Synthworx</a></span><div><a href="/feedback/audience-cut">Give feedback</a><a href="/">All Synthworx products</a><a href="/caption-desk">Caption Desk · film caption checks</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div></footer></body></html>
